  "services": {
    "zapisz_parametr": {
      "name": "Zapisz nastawę",
      "description": "Zapisuje jedną nastawę obiegu 1 (A237.1) w zakresie regulatora i nigdy wyżej niż wartość właściciela (sprzed pierwszego zapisu integracji): zadana pokojowa komfort i oszczędna 5–40 °C co 0,5 K, oszczędna nie wyżej niż komfort; krzywa 10–150 °C nierosnąca z temperaturą zewnętrzną; maks. zasilania 10–150 °C jednorazowo. Każda nastawa najwyżej raz na dobę, łącznie 10 zapisów na dobę. Po kilku sekundach czyta wartość kontrolnie.",
      "fields": {
        "pnu": {
          "name": "Parametr",
          "description": "Parametr (PNU Danfoss): 11180 zadana pokojowa komfort, 11181 oszczędna, 11400–11405 krzywa przy −30/−15/−5/0/5/15 °C, 11178 maks. zasilania."
        },
